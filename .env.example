# Copiar a .env.local con los valores de: firebase apps:sdkconfig WEB <appId> --project hanzi-master-701f9
# (la config web de Firebase no es secreta, pero se mantiene fuera del repo por prolijidad)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check (opcional): site key de reCAPTCHA Enterprise. Si está vacía, App Check queda desactivado.
VITE_APPCHECK_SITE_KEY=
# Modelo de Gemini para "Completar con IA" (opcional; por defecto gemini-3.5-flash).
VITE_AI_MODEL=
